{
  "name": "tomail",
  "productName": "Tomail",
  "version": "0.9.2",
  "description": "Tomail \u2014 a fast desktop email client for Gmail and Google Workspace",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5174 && cross-env VITE_DEV_SERVER_URL=http://localhost:5174 electron .\"",
    "build": "vite build",
    "start": "npm run build && electron .",
    "test": "node --test",
    "dist": "npm run build && electron-builder --publish never",
    "oauth:client": "node scripts/write-oauth-client.mjs",
    "release": "npm run build && electron-builder --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "imapflow": "^2.0.2",
    "mailparser": "^3.9.26",
    "nodemailer": "^10.0.9"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.16.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite": "^8.3.0",
    "wait-on": "^9.0.1"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true
  },
  "build": {
    "appId": "app.tomail.desktop",
    "productName": "Tomail",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "dist/**",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Network",
      "maintainer": "TommyT1988"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "TommyT1988",
        "repo": "tomail",
        "releaseType": "release"
      }
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "icon": "build/icon.png"
  },
  "license": "MIT",
  "author": "Tomas (TommyT1988)",
  "homepage": "https://github.com/TommyT1988/tomail",
  "repository": {
    "type": "git",
    "url": "https://github.com/TommyT1988/tomail.git"
  }
}
